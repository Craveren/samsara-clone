{
  "mcpServers": {
    "plura-reader": {
      "command": "node",
      "args": ["./mcp-servers/plura-reader.js"],
      "env": {
        "PLURA_GITHUB_REPO": "denvudd/plura",
        "PLURA_LOCAL_PATH": "../plura",
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "clerk": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-clerk"],
      "env": {
        "CLERK_SECRET_KEY": "${CLERK_SECRET_KEY}",
        "CLERK_PUBLISHABLE_KEY": "${CLERK_PUBLISHABLE_KEY}"
      }
    },
    "file-system": {
      "command": "node",
      "args": ["./mcp-servers/file-system.js"],
      "env": {
        "ALLOWED_PATHS": "${PWD}/**"
      }
    }
  }
}

